# 投行研究院晨报系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM API 配置（必填）
# ============================================

# MiniMax API 密钥
MINIMAX_API_KEY=your_minimax_api_key_here

# LLM API 基础 URL（可选，默认为 MiniMax）
LLM_BASE_URL=https://api.minimaxi.com/v1

# LLM 模型名称（可选，默认为 MiniMax-M2.7）
LLM_MODEL=MiniMax-M2.7

# 或者使用 OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4-turbo


# ============================================
# 数据源 API 配置（可选，用于生产环境）
# ============================================

# Bloomberg Terminal API
# BLOOMBERG_API_KEY=your_bloomberg_key

# Wind 万得 API
# WIND_API_KEY=your_wind_key
# WIND_API_SECRET=your_wind_secret

# Trading Economics API
# TRADING_ECONOMICS_KEY=your_te_key

# Unusual Whales API（期权数据）
# UNUSUAL_WHALES_KEY=your_uw_key

# IEX Cloud API（实时市场数据）
# IEX_CLOUD_KEY=your_iex_key

# Alpha Vantage API（备用市场数据）
# ALPHA_VANTAGE_KEY=your_av_key


# ============================================
# 系统配置（可选）
# ============================================

# 报告输出目录
# OUTPUT_DIR=reports_professional

# 时区设置
# TIMEZONE=Asia/Shanghai

# 日志级别（DEBUG, INFO, WARNING, ERROR）
# LOG_LEVEL=INFO

# 是否启用缓存
# ENABLE_CACHE=true

# 缓存过期时间（秒）
# CACHE_EXPIRY=3600


# ============================================
# 通知配置（可选）
# ============================================

# 邮件通知
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_email_password
# NOTIFICATION_EMAIL=team@yourcompany.com

# 企业微信机器人
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 钉钉机器人
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx


# ============================================
# 代理配置（可选，如需要）
# ============================================

# HTTP 代理
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# 不使用代理的地址
# NO_PROXY=localhost,127.0.0.1
