# Morning Research Workbench environment example
# Copy this file to `.env` and fill in the values you actually use.

# ============================================
# LLM configuration
# ============================================

DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=http://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Optional fallback provider
# MINIMAX_API_KEY=your_minimax_api_key_here

# Optional OpenAI-compatible setup
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1


# ============================================
# Optional production data sources
# ============================================

# BLOOMBERG_API_KEY=your_bloomberg_key
# WIND_API_KEY=your_wind_key
# TRADING_ECONOMICS_KEY=your_te_key
# UNUSUAL_WHALES_KEY=your_uw_key
# IEX_CLOUD_KEY=your_iex_key


# ============================================
# Runtime options
# ============================================

# OUTPUT_DIR=reports_professional
# TIMEZONE=Asia/Hong_Kong
# LOG_LEVEL=INFO


# ============================================
# Network / proxy options
# ============================================

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
